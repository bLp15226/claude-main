# ─────────────────────────────────────────────────────────────────────────
# FRONTEND ENV  (safe to expose — these get bundled into the browser build)
# Vite only exposes variables that start with VITE_.
# Copy this file to ".env", fill in real values. NEVER commit ".env".
# ─────────────────────────────────────────────────────────────────────────

# Supabase — the anon key is designed to be public; Row Level Security
# (RLS) is what actually protects your data. Safe to ship in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ─────────────────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS  —  DO NOT PUT THESE IN THIS FILE OR IN THE FRONTEND.
#
# Every key below can read/charge/control a real account, so it must never
# reach the browser. These live in Supabase Edge Function secrets, set via
# the Supabase dashboard or:  supabase secrets set NAME=value
#
# Listed here ONLY so the full required set is documented in one place.
# ─────────────────────────────────────────────────────────────────────────
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ADMIN_TOKEN=
# HEVY_API_KEY=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_AD_ACCOUNT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OMNISEND_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# FISH_AUDIO_API_KEY=
