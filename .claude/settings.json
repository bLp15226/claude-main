{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Edit(**)",
      "Write(**)",
      "Read",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(git push -u origin claude/*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Edit(.env)",
      "Write(.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  },
  "enabledPlugins": {
    "watch@claude-video": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for p in \"$CLAUDE_PROJECT_DIR/.claude/scripts/mobile-session-init.sh\" \"$CLAUDE_PROJECT_DIR/scripts/mobile-session-init.sh\"; do [ -f \"$p\" ] && exec bash \"$p\"; done; exit 0",
            "timeout": 300,
            "statusMessage": "Checking /watch environment"
          }
        ]
      }
    ]
  }
}